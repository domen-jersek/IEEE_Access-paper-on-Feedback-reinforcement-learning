# Results (large JSONs, generated answers)
#results/

# Python
__pycache__/
*.pyc
.venv/

# Data (processed artifacts are reusable; raw is referenced from parent)
data/raw/
data/processed/*.parquet
data/processed/*.json
data/processed/*.csv
data/processed/splits/

# Notebook checkpoints
notebooks/.ipynb_checkpoints/
experiments/experiment_table_idea.md

# Environment
.env
.env.example

# Keep the structure but not the artifacts
!data/raw/.gitkeep
!data/processed/.gitkeep
!results/.gitkeep
!configs/.gitkeep
!tests/.gitkeep
!notebooks/.gitkeep
# Embedding / generation / judge caches (regenerable)
data/cache/
results/retriever_ladder/pools/

# Revision artifacts may contain confidential ticket data and local identifiers.
# Keep implementation/configuration/docs tracked; publish only explicitly approved exports.
data/processed/revision/
results/revision/
# Revision generated runs contain confidential ticket text and answers.
results/M4_intersection_eval_*_rev_*/
# Raw human-study ratings stay local; aggregate results are committed.
revision_ieee_access/02_human_study/evaluation_*/
study_bundle.zip
